# SessionWeave relay — environment configuration example
#
# Copy to `.env` and adjust. EVERY variable is OPTIONAL: the values shown are the
# built-in defaults and reproduce the relay's out-of-the-box behavior. Load with your
# process manager, e.g.:
#   docker run --env-file .env -p 8765:8765 sessionweave:latest
#   # or: set -a; . ./.env; set +a; sessionweave
#
# Empty value = feature disabled / derived at runtime (noted per entry).

# ── Process binding ──────────────────────────────────────────────────────────
SW_HOST=0.0.0.0
SW_PORT=8765
# Comma-separated CIDRs/IPs whose X-Forwarded-* and Host headers uvicorn will trust.
# Behind a reverse proxy / TLS terminator, set this to the proxy (and/or docker
# bridge), e.g. "172.17.0.0/16,127.0.0.1".
SW_FORWARDED_ALLOW_IPS=127.0.0.1

# ── Public addressing — used by the GET /invite/<sid> participation brief ────
# Absolute base URL the brief advertises in its curl examples. Leave EMPTY to
# derive it from the (forwarded) request. Set it when behind a proxy whose public
# URL differs from what the relay sees, e.g. https://broker.sessionweave.com
SW_PUBLIC_BASE_URL=

# ── /invite brief — optional Tier 1-3 upgrade pointers ───────────────────────
# URLs the brief points agents at for richer / persistent / autonomous participation.
# Leave EMPTY and the brief simply tells agents to "ask your operator".
SW_SKILL_URL=
SW_MCP_SNIPPET_URL=
SW_RUNNER_INSTALL_URL=

# ── Security / auth (STRONGLY recommended for multi-tenant production) ────────
# When set, GET /metrics requires `Authorization: Bearer <token>` (else open);
# the relay admin token (SW_ADMIN_TOKEN) is accepted too.
SW_METRICS_TOKEN=
# Relay-wide admin token. Grants operator access to the firehose, supervisor
# notes and session deletion for every session. Unset = no admin access.
SW_ADMIN_TOKEN=
# DNS-rebinding guard. Defaults to loopback only; add the hosts you serve under,
# comma-separated, e.g. "broker.sessionweave.com,broker.sessionweave.com:443".
SW_ALLOWED_HOSTS=
# CORS allow-list (comma-separated origins). EMPTY = wildcard "*" — safe here because
# auth is bearer-only on every request (no cookies, allow_credentials is always false).
SW_CORS_ORIGINS=
# Agent launchers (open mode): shared secret a launcher must send as
# `Authorization: Bearer` on /v1/launchers/connect. Unset = any launcher that can
# reach the broker may register (a warning is logged at startup). In account mode
# launchers authenticate with an account token instead.
# With SW_PERSISTENCE_DB_PATH set, an open-mode broker also lets ANY client that reaches
# it (no credential) list machines, deploy agent definitions to launchers started with
# --local or --root, and forget offline machines (/v1/launchers...): LAN-only trust.
# This token gates the launchers' own connections only.
SW_LAUNCHER_TOKEN=
# Seconds a launched agent has to join with its launch credential (1..3600).
SW_LAUNCH_JOIN_TIMEOUT_S=120
# Seconds a disconnected launcher has to reconnect and report its running agents
# before they are removed with reason launcher_lost (1..86400).
SW_LAUNCHER_RECONNECT_GRACE_S=300
# Largest accepted HTTP request body in bytes; larger gets 413 payload_too_large.
SW_MAX_REQUEST_BYTES=5242880
# Per client IP, POSTs that open a new MCP transport per minute; excess gets 429.
SW_MCP_NEW_SESSIONS_PER_MINUTE=30

# ── Session creation mode / accounts ─────────────────────────────────────────
# `open` (anyone may create sessions) or `account` (an account token is needed to
# create sessions; requires SW_PERSISTENCE_DB_PATH and SW_ADMIN_TOKEN).
SW_SESSION_CREATION=open
# Live sessions one account may own (beyond: 429 account_session_limit).
SW_ACCOUNT_MAX_SESSIONS=100
# Active tokens one account may hold (beyond: 409 account_token_limit).
SW_ACCOUNT_MAX_TOKENS=20
# Days the per-account event log is kept.
SW_ACCOUNT_EVENTS_RETENTION_DAYS=30
# Days an open-mode machine (v2 launcher, persistence DB) may stay offline before
# it is forgotten with its deployed agent definitions.
SW_OPEN_MACHINES_RETENTION_DAYS=30

# ── Persistence (opt-in; EMPTY = in-memory only = Zero Data Retention) ───────
# Set a path to enable DB-backed sessions, e.g. data/sessionweave.db
SW_PERSISTENCE_DB_PATH=
SW_PERSISTENCE_DB_POOL_SIZE=4
SW_PERSISTENCE_SWEEP_INTERVAL_SECONDS=60
SW_PERSISTENCE_UNTIL_DELETED_SAFETY_SECONDS=7776000

# ── Supervisor-note rate limits ──────────────────────────────────────────────
SW_SUPERVISOR_NOTES_PER_MINUTE=30
SW_SUPERVISOR_NOTES_PER_HOUR=200

# ── Firehose ─────────────────────────────────────────────────────────────────
SW_MAX_FIREHOSE_PER_SESSION=16
SW_FIREHOSE_QUEUE_CAPACITY=256

# ── Session factory defaults (applied to new sessions) ───────────────────────
SW_DEFAULT_MAX_PARTICIPANTS=16
SW_DEFAULT_MAX_PAYLOAD_BYTES=262144
SW_DEFAULT_IDLE_TTL_SECONDS=1800
SW_DEFAULT_COMMAND_TIMEOUT_SECONDS=60
SW_DEFAULT_MAX_COMMAND_TIMEOUT_SECONDS=300
SW_DEFAULT_OFFLINE_GRACE_SECONDS=300
SW_DEFAULT_MAX_PENDING_NOTIFICATIONS=1000
SW_DEFAULT_MAX_WAIT_SECONDS=600
SW_DEFAULT_MAX_CONCURRENT_WAITS_TOTAL=1000
SW_DEFAULT_MAX_WAIT_SECONDS_MCP=20
SW_DEFAULT_MAX_BUFFER_BYTES_PER_SESSION=52428800
# Agents launchers may run per session (0 = launching disabled).
SW_DEFAULT_MAX_LAUNCHED_AGENTS=10

# ── Per-session config bounds [min, max] a client may request ────────────────
# (Advanced. The factory defaults above must stay within these ranges at startup.)
SW_MIN_MAX_PARTICIPANTS=2
SW_MAX_MAX_PARTICIPANTS=256
SW_MIN_MAX_PAYLOAD_BYTES=1024
SW_MAX_MAX_PAYLOAD_BYTES=4194304
SW_MIN_IDLE_TTL_SECONDS=60
SW_MAX_IDLE_TTL_SECONDS=86400
SW_MIN_DEFAULT_COMMAND_TIMEOUT_SECONDS=1
SW_MIN_MAX_COMMAND_TIMEOUT_SECONDS=1
SW_MAX_MAX_COMMAND_TIMEOUT_SECONDS=3600
SW_MIN_OFFLINE_GRACE_SECONDS=0
SW_MAX_OFFLINE_GRACE_SECONDS=3600
SW_MIN_MAX_PENDING_NOTIFICATIONS=0
SW_MAX_MAX_PENDING_NOTIFICATIONS=100000
SW_MIN_MAX_WAIT_SECONDS=1
SW_MAX_MAX_WAIT_SECONDS=3600
SW_MIN_MAX_CONCURRENT_WAITS_TOTAL=0
SW_MAX_MAX_CONCURRENT_WAITS_TOTAL=100000
SW_MIN_MAX_WAIT_SECONDS_MCP=1
SW_MAX_MAX_WAIT_SECONDS_MCP=60
SW_MIN_MAX_BUFFER_BYTES_PER_SESSION=1048576
SW_MAX_MAX_BUFFER_BYTES_PER_SESSION=4294967296
SW_MIN_MAX_LAUNCHED_AGENTS=0
SW_MAX_MAX_LAUNCHED_AGENTS=100
SW_MIN_PERSISTENCE_TTL_SECONDS=3600
SW_MAX_PERSISTENCE_TTL_SECONDS=7776000
SW_MIN_PERSISTENCE_DB_POOL_SIZE=1
SW_MAX_PERSISTENCE_DB_POOL_SIZE=32
SW_MIN_PERSISTENCE_SWEEP_INTERVAL_SECONDS=10
SW_MAX_PERSISTENCE_SWEEP_INTERVAL_SECONDS=3600

# ── Logging (file output; journald/console output is unaffected) ──────────────
# Rotating log file, written by default. Set SW_LOG_FILE empty to disable.
SW_LOG_FILE=~/.sessionweave/logs/broker.log
SW_LOG_MAX_BYTES=10485760
SW_LOG_BACKUP_COUNT=5

# --- MCP transport (mcp 2.x) -------------------------------------------------
# How long the SDK keeps an idle MCP transport before terminating it. Past it
# the session id answers HTTP 404 and the client must re-initialize and call
# session_resume. This is also what reclaims a transport whose client vanished
# without a DELETE. 0 disables it, which is not recommended.
SW_MCP_SESSION_IDLE_TIMEOUT=1800
# Cap on concurrent MCP transports; beyond it the SDK answers HTTP 503.
SW_MCP_MAX_SESSIONS=10000
